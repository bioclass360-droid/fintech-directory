---
interface Props {
  formId?: string;
  headline?: string;
  subtext?: string;
  buttonText?: string;
}

const {
  formId = 'YOUR_CONVERTKIT_FORM_ID', // You can replace this later when you set up an email provider
  headline = 'Get the 2026 Trading Platform Cognitive Load Report',
  subtext = 'We scored 40+ platforms on execution latency and UI friction. Free download.',
  buttonText = 'Send me the report →',
} = Astro.props;
---

<div class="email-capture">
  <p class="ec-headline">{headline}</p>
  <p class="ec-sub">{subtext}</p>
  <form
    action={`https://app.convertkit.com/forms/${formId}/subscriptions`}
    method="post"
    data-sv-form={formId}
    class="ec-form"
  >
    <input
      type="email"
      name="email_address"
      placeholder="your@email.com"
      required
      class="ec-input"
      aria-label="Email address"
    />
    <button type="submit" class="ec-btn">{buttonText}</button>
  </form>
  <p class="ec-fine">No spam. Unsubscribe anytime.</p>
</div>

<style>
  .email-capture {
    border: 1px solid var(--sl-color-accent);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
    background: var(--sl-color-bg-nav);
  }
  .ec-headline {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
    color: var(--sl-color-white);
  }
  .ec-sub {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    margin: 0 0 1rem;
  }
  .ec-form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .ec-input {
    flex: 1;
    min-width: 200px;
    padding: 0.6rem 0.75rem;
    border-radius: 5px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.9rem;
  }
  .ec-btn {
    padding: 0.6rem 1.25rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    border: none;
    border-radius: 5px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .ec-btn:hover { 
    opacity: 0.85; 
  }
  .ec-fine {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    margin: 0.5rem 0 0;
  }
</style>